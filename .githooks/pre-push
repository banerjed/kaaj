#!/usr/bin/env bash
# Runs `./check --all` before every push: everything, the browser suite, and
# every page against its perf budget (CLAUDE.md, "Required before pushing").
# Enabled by ./setup (`git config core.hooksPath .githooks`). `git push
# --no-verify` skips it — for an emergency, not for a red check.
set -uo pipefail

pushing=0
while read -r _ local_sha _ _; do
  [ "$local_sha" != 0000000000000000000000000000000000000000 ] && pushing=1
done
# Deleting a remote branch pushes no code.
[ "$pushing" = 0 ] && exit 0

# ./check tests the working tree, not the commits being pushed; a tracked
# change that is not committed would be tested and then not pushed.
if ! git diff --quiet HEAD --; then
  echo "pre-push: uncommitted changes to tracked files — commit or stash them, so" >&2
  echo "          ./check tests what is being pushed:" >&2
  git diff --stat HEAD -- >&2
  exit 1
fi

exec "$(git rev-parse --show-toplevel)/check" --all
