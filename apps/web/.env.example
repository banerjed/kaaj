# =============================================================================
# Kaaj — environment template
# =============================================================================
# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
#
#   LOCAL   values come from `supabase start` (it prints them; `supabase status`
#           reprints them). They are the same on every machine — the local stack
#           uses fixed demo keys — so they are safe to keep here as defaults.
#   REMOTE  values come from the Supabase dashboard:
#           Project Settings -> API. Never commit these.
# =============================================================================

# --- Supabase: LOCAL defaults (supabase start) -------------------------------
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
PRIVATE_SUPABASE_SERVICE_ROLE="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

# Direct Postgres, used by the DB test harnesses (never by the app itself).
# LOCAL only — ./check defaults to this value if unset.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# PRODUCTION Postgres, for the read-only checker only. Deliberately a different
# variable so that pointing a harness at production is a conscious act:
#   SUPABASE_DB_URL=... packages/database/tests/verify-remote.sh
SUPABASE_DB_URL=""

# The connection the APPLICATION uses. Deliberately a different role and a
# different variable from DATABASE_URL above.
#
# app_user is a non-owner. FORCE ROW LEVEL SECURITY is bypassed by the table
# OWNER, so connecting as `postgres` gives an application RLS in name only —
# every isolation bug then stays invisible until production. The password is a
# local demo credential set by ./setup; on a real deployment it comes from the
# secret store and never from a file like this.
APP_DATABASE_URL=postgresql://app_user:app_user@127.0.0.1:54322/postgres

# --- Third party (optional in development) -----------------------------------
PRIVATE_STRIPE_API_KEY=""
PRIVATE_RESEND_API_KEY=""
PRIVATE_ADMIN_EMAIL=""
PRIVATE_FROM_ADMIN_EMAIL=""
