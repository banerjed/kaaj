# Dependencies
node_modules/
.pnpm-store/

# Turborepo
.turbo/

# Build output
**/build/
**/.svelte-kit/
**/.vercel/
**/.output/
**/dist/
# ...except the generated SQL fixture, which is committed so CI can assert it is
# current. A stale fixture would otherwise silently test the wrong expectation.
!packages/enums/dist/
!packages/enums/dist/expected-enums.sql

# Supabase CLI local state. .temp/ holds linked-project.json with the live
# project ref — it must never be committed.
supabase/.temp/
supabase/.branches/
supabase/.env*
**/supabase/.temp/

# Environment
.env
.env.*
!.env.example
!**/.env.example

# Misc
.DS_Store
*.log
/tmp/
