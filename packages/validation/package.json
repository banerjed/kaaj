{
  "name": "@kaaj/validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sanitisation and validation for country-specific identity, tax and bank formats",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
