    "format": "prettier --write src test"
  },
  "devDependencies": {
    "vitest": "^3.0.7",
    "@kaaj/eslint-config": "workspace:*",
    "eslint": "^9.0.0"
  },
  "types": "./src/index.d.ts"
}
