#!/usr/bin/env bash
# =============================================================================
# ./check — run every test in the repository
# =============================================================================
# One command, no setup, runnable from any directory in the repo.
#
#   ./check              everything (what you run before pushing)
#   ./check --db         database only
#   ./check --app        application only
#   ./check --quick      skip the build (fastest useful signal)
#
# Exits non-zero if anything fails. Finds psql, resolves DATABASE_URL, and
# checks the local Supabase stack is up before running anything that needs it.
# =============================================================================
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# --- colours, only when attached to a terminal -------------------------------
if [ -t 1 ]; then
  R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[1m'; D=$'\033[2m'; N=$'\033[0m'
else
  R=""; G=""; Y=""; B=""; D=""; N=""
fi

RUN_DB=1; RUN_APP=1; RUN_BUILD=1
case "${1:-}" in
  --db)    RUN_APP=0 ;;
  --app)   RUN_DB=0 ;;
  --quick) RUN_BUILD=0 ;;
  --help|-h)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  "") ;;
  *) echo "unknown option: $1 (try --help)" >&2; exit 2 ;;
esac

FAILED=()
PASSED=0
START=$(date +%s)

step() {  # step <name> <command...>
  local name="$1"; shift
  printf "  %-34s" "$name"
  local out
  if out="$("$@" 2>&1)"; then
    printf "%s✓%s\n" "$G" "$N"
    PASSED=$((PASSED + 1))
  else
    printf "%s✗%s\n" "$R" "$N"
    FAILED+=("$name")
    # Indent the failure output so it is obviously subordinate to the step.
    printf "%s" "$D"
    echo "$out" | tail -25 | sed 's/^/      /'
    printf "%s" "$N"
  fi
}

# --- locate psql -------------------------------------------------------------
# Homebrew keeps versioned postgres off PATH; check the usual places before
# giving up, so a fresh clone works without shell configuration.
find_psql() {
  command -v psql >/dev/null 2>&1 && { echo psql; return; }
  for p in /opt/homebrew/opt/postgresql@17/bin/psql \
           /usr/local/opt/postgresql@17/bin/psql \
           /opt/homebrew/opt/libpq/bin/psql \
           /usr/lib/postgresql/17/bin/psql; do
    [ -x "$p" ] && { echo "$p"; return; }
  done
}

echo ""
echo "${B}Kaaj — full check${N}"
echo ""

# =============================================================================
# Database
# =============================================================================
if [ "$RUN_DB" = 1 ]; then
  PSQL="$(find_psql)"
  if [ -z "$PSQL" ]; then
    echo "  ${Y}skipping database checks:${N} psql not found"
    echo "  ${D}install with: brew install postgresql@17${N}"
    echo ""
    RUN_DB=0
  else
    export PATH="$(dirname "$PSQL"):$PATH"
    : "${DATABASE_URL:=postgresql://postgres:postgres@127.0.0.1:54322/postgres}"
    export DATABASE_URL

    if ! psql "$DATABASE_URL" -X -t -A -c "SELECT 1" >/dev/null 2>&1; then
      echo "  ${R}cannot reach the database${N} at ${DATABASE_URL%%\?*}"
      echo "  ${D}start it with: supabase start${N}"
      echo ""
      FAILED+=("database unreachable")
      RUN_DB=0
    fi
  fi
fi

if [ "$RUN_DB" = 1 ]; then
  echo "${B}Database${N}"
  step "tenant isolation (587)"    psql "$DATABASE_URL" -X -q -v ON_ERROR_STOP=1 -v strict=1 -f packages/database/tests/verify-rls.sql
  step "specification (167)"       psql "$DATABASE_URL" -X -q -v ON_ERROR_STOP=1 -v strict=1 -f packages/database/tests/verify-stories.sql
  step "schema invariants (133)"    psql "$DATABASE_URL" -X -q -v ON_ERROR_STOP=1 -v strict=1 -v enum_fixture="$ROOT/packages/enums/dist/expected-enums.sql" -f packages/database/tests/verify-invariants.sql
  step "structure snapshot"        packages/database/scripts/db-snapshot.sh --check
  step "enum fixture is current"   bash -c 'pnpm --filter @kaaj/enums build >/dev/null && git diff --quiet packages/enums/dist/expected-enums.sql'
  step "actions are authorized"    node scripts/verify-authz.mjs
  echo ""
fi

# =============================================================================
# Application
# =============================================================================
if [ "$RUN_APP" = 1 ]; then
  if [ ! -d node_modules ]; then
    echo "  ${Y}installing workspace dependencies${N}"
    pnpm install --silent || FAILED+=("pnpm install")
  fi
  echo "${B}Application${N}"
  # Driven through turbo so local and CI run the identical task graph, and so
  # future apps and packages are picked up without editing this script.
  step "format"     pnpm turbo run format:check
  step "lint"       pnpm turbo run lint
  step "typecheck"  pnpm turbo run check-types
  # Listed separately although `turbo run test` also covers it. The 0.6s of
  # duplicate execution buys a line you can point at in an audit: without it,
  # 346 authorization, PII and tenant-isolation cases are invisible inside a
  # single "unit tests" number. It spans BOTH halves — the requirement model in
  # @kaaj/spec-tests and the deployed enforcement in @kaaj/web — because a
  # security line covering only the model would be the more misleading of the
  # two.
  step "security"   pnpm test:security
  step "unit tests" pnpm turbo run test
  [ "$RUN_BUILD" = 1 ] && step "build" pnpm turbo run build
  echo ""
fi

# =============================================================================
# Summary
# =============================================================================
ELAPSED=$(( $(date +%s) - START ))
if [ ${#FAILED[@]} -eq 0 ]; then
  echo "${G}${B}All checks passed${N} ${D}(${PASSED} steps, ${ELAPSED}s)${N}"
  echo ""
  exit 0
else
  echo "${R}${B}${#FAILED[@]} check(s) failed${N} ${D}(${PASSED} passed, ${ELAPSED}s)${N}"
  for f in "${FAILED[@]}"; do echo "  ${R}✗${N} $f"; done
  echo ""
  echo "${D}Schema drift? If the change is intended:  ./check --db${N}"
  echo "${D}  supabase db reset && pnpm db:snapshot${N}"
  echo ""
  exit 1
fi
