{
  "name": "kaaj",
  "private": true,
  "version": "0.0.0",
  "description": "Unified workplace management software",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter @kaaj/web",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "check-types:spec": "pnpm --filter @kaaj/spec-tests check-types",
    "test": "turbo run test",
    "test:security": "pnpm --filter @kaaj/spec-tests test:security",
    "test:spec": "pnpm --filter @kaaj/spec-tests test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check": "./check",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:snapshot": "packages/database/scripts/db-snapshot.sh --generate",
    "db:check": "packages/database/scripts/db-snapshot.sh --check"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "prettier": "^3.1.0"
  },
  "pnpm": {
    "overrides": {
      "@supabase/auth-ui-svelte>svelte": "^5.0.0",
      "@supabase/ssr>cookie": "^0.7.0",
      "@sveltejs/kit>cookie": "^0.7.0"
    }
  }
}
